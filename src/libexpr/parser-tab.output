    9              | LET binds IN_KW expr_function
   10              | expr_if

   11 expr_if: IF expr THEN expr ELSE expr
   12        | expr_op

   13 expr_op: '!' expr_op
   14        | '-' expr_op
   15        | expr_op EQ expr_op
   16        | expr_op NEQ expr_op
   17        | expr_op '<' expr_op
