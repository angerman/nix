   27        | expr_op '-' expr_op
   28        | expr_op '*' expr_op
   29        | expr_op '/' expr_op
   30        | expr_op CONCAT expr_op
   31        | expr_app

   32 expr_app: expr_app expr_select
   33         | expr_select

   34 expr_select: expr_simple '.' attrpath
   35            | expr_simple '.' attrpath OR_KW expr_select
   36            | expr_simple OR_KW
   37            | expr_simple

   38 expr_simple: ID
