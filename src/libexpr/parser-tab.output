   61 ind_string_parts: ind_string_parts IND_STR
   62                 | ind_string_parts DOLLAR_CURLY expr '}'
   63                 | ε

   64 binds: binds attrpath '=' expr ';'
   65      | binds INHERIT attrs ';'
   66      | binds INHERIT '(' expr ')' attrs ';'
   67      | ε

   68 attrs: attrs attr
   69      | attrs string_attr
   70      | ε

   71 attrpath: attrpath '.' attr
   72         | attrpath '.' string_attr
